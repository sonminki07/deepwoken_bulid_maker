    "creator_opinion": "\uc774 \ube4c\ub4dc\ub294 540\uc774 \ub118\ub294 \uccb4\ub825\uacfc 50% \uc774\uc0c1\uc758 \ub192\uc740 \ubb3c\ub9ac \uc800\ud56d\ub825\uc744 \uc790\ub791\ud558\ub294 \ud504\ub85c\uc2a4\ud2b8\ub4dc\ub85c\uc6b0(Frostdraw) \uae30\ubc18\uc758 \ubbf8\ub514\uc5c4 \uc6e8\ud3f0 PvP \ube4c\ub4dc\uc785\ub2c8\ub2e4. Shrine of Order\ub97c \ud65c\uc6a9\ud558\uc5ec \ud504\ub9ac shrine \ub2e8\uacc4\uc5d0\uc11c \ud575\uc2ec \uc720\ud2f8\ub9ac\ud2f0 \ubc0f stats \uc694\uad6c\uce58\ub97c \ucda9\uc871\ud55c \ub4a4, \ud3ec\ud2f0\ud29c\ub4dc 50, \ubbf8\ub514\uc5c4 \uc6e8\ud3f0 95, \ud504\ub85c\uc2a4\ud2b8\ub4dc\ub85c\uc6b0 80\uc744 \ud655\ubcf4\ud558\uc5ec \uac15\ub825\ud55c \ud0f1\ud0b9\ub825\uacfc \uc18d\uc131 \ud3ed\ub51c\uc744 \uacb8\ube44\ud588\uc2b5\ub2c8\ub2e4.\n\n\uc624\uc2a4\ub9ac\uc2a4(Oathless)\ub97c \ucc44\ud0dd\ud574 \ucd94\uac00 mantras \uc2ac\ub86f\uc744 \ud655\ubcf4\ud568\uc73c\ub85c\uc368 Ice Smash, Ice Flock, Ice Lance \ub4f1 \ud504\ub85c\uc2a4\ud2b8\ub4dc\ub85c\uc6b0\uc758 \uc6b0\uc218\ud55c \uc18d\uc131 mantras\ub4e4\uc744 \ud480 \uc138\ud305\uc73c\ub85c \uc6b4\uc6a9\ud569\ub2c8\ub2e4.\n\n\ub192\uc740 \ub9f7\uc9d1\uc73c\ub85c \uad50\uc804 \uc9c0\uc18d\ub825\uc774 \ub6f0\uc5b4\ub098\uba70, \uc0c1\ub300\uc758 \uc6c0\uc9c1\uc784\uc744 \uc81c\uc5b4\ud558\ub294 \ube59\uacb0 \ubc0f \ub454\ud654 \ud6a8\uacfc\uc640 \uac15\ub825\ud55c \ubbf8\ub514\uc5c4 weapons \ud3c9\ud0c0 \ucf64\ubcf4\ub97c \ud1b5\ud574 1v1 \ub2e4\uc5d8\uc740 \ubb3c\ub860 \ub2e4\ub300\uc77c \uac31\ud06c(Gank)\uc804\uc5d0\uc11c\ub3c4 \uc555\ub3c4\uc801\uc778 \uc2b9\ub960\uc744 \ubcf4\uc5ec\uc8fc\ub294 \ube4c\ub4dc\uc785\ub2c8\ub2e4.",
