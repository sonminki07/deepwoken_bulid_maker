  "mob_strategy": [
    "\ube60\ub978 \ub808\uc774\ud53c\uc5b4 \ud3c9\ud0c0 \uc5f0\uacc4\ub85c \ubaac\uc2a4\ud130\uc758 \uac00\ub4dc\ub97c \uc555\ubc15\ud558\uace0 \ud2c8\uc744 \ub9cc\ub4e4\uc5b4 \ud0c0\uaca9\uc744 \ub204\uc801\ud569\ub2c8\ub2e4.",
    "Flame Assault\ub97c \ud65c\uc6a9\ud574 \uc801\uc758 \uacf5\uaca9 \ub51c\ub808\uc774 \ud0c0\uc774\ubc0d\uc5d0 \uc9c4\uc785\ud558\uc5ec \ud070 \ub300\ubbf8\uc9c0\ub97c \uc8fc\uace0 \ube60\uc838\ub098\uc635\ub2c8\ub2e4.",
    "\ub2e4\uc911 \ud0c0\uaca9 \ud06c\ub9ac\ud2f0\uceec \uacf5\uaca9\uc744 \ud1b5\ud574 \ud654\uc5fc \ubc0f \uc778\ucc48\ud2b8 \ud504\ub85c\ud06c\ub97c \ubc1c\ub3d9\uc2dc\ucf1c \ud2b8\ub8e8 \ub370\ubbf8\uc9c0\ub97c \uc548\uc815\uc801\uc73c\ub85c \uc6b0\uaca8\ub123\uc2b5\ub2c8\ub2e4.",
    "\uc801\uc758 \uad11\uc5ed \ud328\ud134\uc774\ub098 \uc704\ud5d8\ud55c \uacf5\uaca9\uc740 Starkindred\uc758 \uacf5\uc911 \uae30\ub3d9\uc131\uc73c\ub85c \ud68c\ud53c\ud558\uba70 \uc548\uc804\ud55c \uac70\ub9ac\ub97c \uc720\uc9c0\ud569\ub2c8\ub2e4."
  ],
