      "\uac00\ub4dc\ube0c\ub808\uc774\ud06c \uc9c0\uc18d \uc2dc\uac04 \uc99d\uac00 talents\ub85c \uc801\uc758 \ubc29\uc5b4 \ud0dc\uc138\ub97c \uc624\ub79c \uc2dc\uac04 \ubb34\ub825\ud654 \uac00\ub2a5"
