    "mob_strategy": "1. \ubaac\uc2a4\ud130 \ubc0f PVE \ubcf4\uc2a4\uc804 \uc2dc Ascension\uc744 \ud1b5\ud574 \uc2dc\uc57c \ubc16 \uace0\uacf5\uc5d0\uc11c \uc9c4\uc785\ud558\uc5ec \uc548\uc804\ud558\uac8c \uc120\uc81c \ud0c0\uaca9\uc744 \ub123\uc2b5\ub2c8\ub2e4.\n2. \ud5e4\ube44 weapons\uc758 \uc911\ub7c9\uac10 \uc788\ub294 \uacf5\uaca9 \ud310\uc815\uc73c\ub85c \ubcf4\uc2a4\uc758 \ud328\ub9c1 \ucfe8\ud0c0\uc784\uc744 \uae4e\uace0 \ud3ec\uc2a4\ucc98 \uc218\uce58\ub97c \uae09\uaca9\ud788 \uae4e\uc544\ub0c5\ub2c8\ub2e4.\n3. \ud654\uc5fc mantras(Grand Skewer, Ash Slam)\ub85c \uc9c0\uc18d \ud654\uc5fc \ud53c\ud574\ub97c \ub204\uc801\uc2dc\ucf1c \uc7a5\uae30\uc804\uc5d0\uc11c \uc548\uc815\uc801\uc778 \uc6b0\uc704\ub97c \uc810\ud569\ub2c8\ub2e4."
  },
  "combo_and_playstyle": {
    "combo_guide": "1. [\uc9c4\uc785 \ubc0f \uc120\uc81c \ud0c0\uaca9]: Starkindred 'Ascension'\uc73c\ub85c \uacf5\uc911\uc5d0 \ub3c4\uc57d\ud55c \ud6c4 \ubaa9\ud45c \uc801\uc744 \ud5a5\ud574 \uae09\uac15\ud558\ud558\uc5ec \ub109\ub2e4\uc6b4\uc744 \uc720\ub3c4\ud569\ub2c8\ub2e4.\n2. [\uac00\ub4dc\ube0c\ub808\uc774\ud06c \uc5f0\uacc4]: \uc801\uc774 \uc77c\uc5b4\uc11c\uba70 \uac00\ub4dc\ub97c \ucde8\ud558\uba74 \ud5e4\ube44 M1 \ud0c0\uaca9 \ub610\ub294 'Fire Blade'\ub85c \uac00\ub4dc\ub97c \ud754\ub4e4\uace0 \uc774\uc5b4\uc11c 'Flame Grab'\uc73c\ub85c \uc7a1\uae30 \uc5f0\uacc4\ub97c \uc2e4\ud589\ud569\ub2c8\ub2e4.\n3. [\ud654\uc5fc \ud3ed\ub51c \ubc0f \ub9c8\ubb34\ub9ac]: \uacf5\uc911/\ub109\ub2e4\uc6b4 \uc0c1\ud0dc\uc758 \uc801\uc5d0\uac8c 'Grand Skewer' \ubc0f 'Ash Slam'\uc744 \uc3df\uc544\ubd80\uc5b4 \ub300\ub7c9\uc758 \ud654\uc5fc \ud53c\ud574\uc640 \ud568\uaed8 \uc5d0\uc5b4\ubcf8/\ucd94\uac00 \ub109\ub2e4\uc6b4\uc744 \uc644\uc131\ud569\ub2c8\ub2e4.\n4. [\uc0dd\uc874 \ubc0f \uc774\ud0c8]: \uc801\uc758 \ubc18\uaca9 \ud0c0\uc774\ubc0d\uc5d0\ub294 'Flame Leap'\uc774\ub098 Starkindred \ub0a0\uac1c \ube44\ud589\uc744 \ud65c\uc6a9\ud574 \uace0\uc9c0\ub300\ub85c \uc774\ud0c8\ud55c \ub4a4 \uccb4\ub825\uacfc \uc774\ub354\ub97c \ud68c\ubcf5\ud569\ub2c8\ub2e4."
