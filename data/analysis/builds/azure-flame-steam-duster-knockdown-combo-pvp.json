    "mob_strategy": [
      "\ubcf4\uc2a4\uc804 \ubc0f \ubaac\uc2a4\ud130 \uc0ac\ub0e5 \uc2dc\uc5d0\ub3c4 \ub109\ub2e4\uc6b4 \ud310\uc815\uacfc \uc2a4\ud300 \ub3c4\ud2b8 \ub300\ubbf8\uc9c0\ub97c \ud65c\uc6a9\ud574 \ubaac\uc2a4\ud130\uc758 \uc288\ud37c\uc544\uba38 \ud328\ud134 \uc0ac\uc774\ub9c8\ub2e4 \ubb34\ud55c \ucf64\ubcf4 \uc9c0\uc18d",
