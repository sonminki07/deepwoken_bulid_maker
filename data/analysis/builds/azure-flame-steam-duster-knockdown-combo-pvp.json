      "\uccb4\ub825\uc774 50% \uc774\ud558\ub85c \ub5a8\uc5b4\uc9c0\uba74 Flame Leap\uc758 \ub3c4\uc57d \uc131\ub2a5\uc774 \uc800\ud558\ub418\uc5b4 \uba54\uc778 \ucf64\ubcf4 \ub9e4\ucee4\ub2c8\uc998 \ubc0f \uae30\ub3d9\uc131\uc774 \ud06c\uac8c \uc57d\ud654\ub428",
