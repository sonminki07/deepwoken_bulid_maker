      "\ubcf4\uc2a4\uac00 \ub300\ud615 \ud328\ud134\uc744 \uce90\uc2a4\ud305\ud560 \ub54c Flame Leap\uc73c\ub85c \ube60\ub974\uac8c \uacf5\uc911\uc73c\ub85c \ud0c8\ucd9c \ud6c4 \uacf5\uc911 \uac15\ud0c0\ub85c \uc5ed\uacf5 \uae30\ud68c \ud3ec\ucc29"
