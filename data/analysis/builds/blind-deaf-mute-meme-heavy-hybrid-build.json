  "build_summary": {
    "build_name": "Blind, Deaf & Mute Meme Heavy Hybrid Build",
    "build_type": "Meme/Fun",
    "difficulty": "Advanced",
    "creator_opinion": "\ubcf8 \ube4c\ub4dc\ub294 \uc815\uc0c1\uc801\uc778 \uccad\uac01\uacfc \uc2dc\uac01, \uc74c\uc131 \uc18c\ud1b5\uc774 \uc644\uc804\ud788 \uc81c\ud55c\ub41c \uadf9\ub2e8\uc801\uc778 \uc608\ub2a5\uc6a9 \ucee8\uc149 \ube4c\ub4dc\ub85c \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. UI\uc640 \uc0ac\uc6b4\ub4dc \uc815\ubcf4\uac00 \ucc28\ub2e8\ub41c \uc0c1\ud0dc\uc5d0\uc11c \uc624\uc9c1 \ud300\uc6d0\uac04\uc758 \ud638\ud761\uacfc \uac10\uac01\uc5d0\ub9cc \uc758\uc874\ud558\uc5ec \ub525\uc704\ud070\uc758 \ucd5c\ub09c\uc811 \uc9c0\uc5ed\uc778 Layer 2\uc640 Chaser, Scion of Ethiron\uae4c\uc9c0 \ub3cc\ud30c\ud574\uc57c \ud558\ub294 \uba54\ucee4\ub2c8\uc998\uc744 \uac00\uc9c0\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\n\uc804\ud22c \uc2dc \uc0ac\uc6b4\ub4dc \ud50c\ub808\uc774\uac00 \ubd88\uac00\ub2a5\ud558\ubbc0\ub85c \uc801\uc758 \uacf5\uaca9 \uc120\ubaa8\uc158\uacfc \ubbf8\uc138\ud55c \ud654\uba74 \ubcc0\ud654\ub97c \ud30c\uc545\ud574\uc57c \ud558\uba70, \ud30c\ud2f0\uc6d0\uacfc\uc758 \uc5f0\uacc4 \ud50c\ub808\uc774\ub97c \ud1b5\ud574 \uac00\ub4dc\ube0c\ub808\uc774\ud06c\uc640 \uc5d0\uc5b4\ubcf8 \ucf64\ubcf4\ub97c \uc6b1\uc5ec\ub123\ub294 \ubc29\uc2dd\uc744 \ucde8\ud569\ub2c8\ub2e4. \ud2b9\ud788 \uc911\ud654\uae30(Heavy Weapon)\uc758 \uac15\ub825\ud55c \uae61\ub380\uacfc \uc2a4\ud0dc\uac70 \ub2a5\ub825\uc744 \ud65c\uc6a9\ud558\uc5ec \uc21c\uac04\uc801\uc778 \ud3ed\ub51c\uc744 \uaf42\uc544\ub123\ub294 \uac83\uc774 \ud575\uc2ec\uc785\ub2c8\ub2e4.\n\n\uc2e4\uc804 \uad50\uc804\uc5d0\uc11c\ub294 \uc0c1\ub300\uc758 \uac00\ub4dc\ub97c \uac15\uc81c\ub85c \ubb34\ub108\ub728\ub9ac\uae30 \uc704\ud574 \ube0c\ub808\uc774\ud06c talents\uc640 \ub109\ub2e4\uc6b4 \uc720\ubc1c\uae30\ub97c \uc801\uc808\ud788 \uc870\ud569\ud574\uc57c \ud569\ub2c8\ub2e4. \uc2dc\uc57c\uac00 \uc81c\ud55c\ub41c \ud658\uacbd \uc18d\uc5d0\uc11c\ub3c4 \ud328\ub9c1 \ud0c0\uc774\ubc0d\uc744 \uc775\ud788\uace0, \ud30c\ud2f0\uc6d0\uc774 \ub300\uc0c1\uc744 \ubd99\uc7a1\uc544\ub458 \ub54c \ud6c4\ubc29\uc5d0\uc11c \uae30\uc2b5\uc801\uc778 \uac15\uacf5\uaca9\uc744 \uc131\uacf5\uc2dc\ud0a4\ub294 \uc2ec\ub9ac\uc804\uc774 \uc2b9\ud328\ub97c \uac00\ub985\ub2c8\ub2e4.",
    "strengths": [
      "\uc911\ud654\uae30(Heavy Weapon) \ud2b9\uc720\uc758 \uc555\ub3c4\uc801\uc778 \ub2e8\ubc1c \ub300\ubbf8\uc9c0\uc640 \ub192\uc740 \ud3ec\uc2a4\ucc98 \ud30c\uad34\ub825",
      "\ud30c\ud2f0 \ud50c\ub808\uc774 \uc2dc \uc2dc\ub108\uc9c0 \uadf9\ub300\ud654\ub85c \ubcf4\uc2a4 \ud328\ud134\uc744 \uc21c\uc2dd\uac04\uc5d0 \ub179\uc77c \uc218 \uc788\ub294 \ud3ed\ub51c \uc7a0\uc7ac\ub825",
      "\uc2dc\uccad\uac01 \ucc28\ub2e8\uc774\ub77c\ub294 \uadf9\uc545\uc758 \uc870\uac74 \uc18d\uc5d0\uc11c\ub3c4 \uc644\ubcbd\ud55c \uc608\ub2a5\uc801 \uc7ac\ubbf8\uc640 \ubab0\uc785\uac10 \uc81c\uacf5"
    ],
    "weaknesses": [
      "\uccad\uac01 \uc815\ubcf4\uc640 UI \uc778\uc2dd\uc774 \ubd88\uac00\ub2a5\ud558\uc5ec \uc194\ub85c \ud50c\ub808\uc774 \uc2dc \uc0dd\uc874\uc728\uc774 \uadf9\ub3c4\ub85c \ub0ae\uc74c",
      "\uc801\uc758 \uc120\ub51c\ub808\uc774\ub97c \uc0ac\uc6b4\ub4dc\ub85c \ud30c\uc545\ud560 \uc218 \uc5c6\uc5b4 \ud328\ub9c1 \ud0c0\uc774\ubc0d\uc774 \ub9e4\uc6b0 \uae4c\ub2e4\ub85c\uc6c0",
      "\ud68c\ud53c \uae30\ub3d9 \uc911 \uc9c0\ud615\uc9c0\ubb3c\uc5d0 \uac78\ub9ac\uac70\ub098 \ub099\uc0ac\ud560 \uc704\ud5d8\uc774 \ub9e4\uc6b0 \ub192\uc74c"
    ]
  },
