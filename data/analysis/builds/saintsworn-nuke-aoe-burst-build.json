  "mob_strategy": [
    "\uc6d0\uac70\ub9ac \ud3ec\uaca9 \ud65c\uc6a9: \ubcf4\uc2a4\ub098 \uac15\ub825\ud55c \ubab9\uacfc\uc758 \uad50\uc804 \uc2dc \uc811\uadfc\ud558\uae30 \uc804 Lava Serpent\uc640 Thunder Serpent\ub97c \ud65c\uc6a9\ud574 \uc6d0\uac70\ub9ac\uc5d0\uc11c \uc548\uc815\uc801\uc73c\ub85c \uccb4\ub825\uc744 \uae4e\uc544\ub0c5\ub2c8\ub2e4.",
    "\uc7a5\ud310 \ubc0f \ud68c\ud53c \uae30\ub3d9: \ubcf4\uc2a4\uc758 \uad11\uc5ed \ud328\ud134 \uc2dc Flame Wisp\uacfc \uae30\ub3d9\uc131 talents\ub97c \ud65c\uc6a9\ud574 \uc548\uc804\ud55c \uac70\ub9ac\ub97c \uc720\uc9c0\ud558\uba70 \uc5d0\ud14c\ub974\ub97c \uc218\uae09\ud569\ub2c8\ub2e4.",
    "\uc2a4\ud0dc\ubbf8\ub098 \uad00\ub9ac: \ucf64\ubcf4 \ub3c4\uc911 \uc2a4\ud0dc\ubbf8\ub098\uac00 \ubc14\ub2e5\ub098\uc9c0 \uc54a\ub3c4\ub85d \uac00\ub4dc\uc640 \ud328\ub9ac \ud0c0\uc774\ubc0d\uc744 \uc870\uc808\ud558\uba70, \uc708\ub4dc\uc5c5(Wind Up) \ubca8\uc744 \ud1b5\ud574 \uc704\uae30 \uc0c1\ud669\uc744 \ud0c8\ucd9c\ud569\ub2c8\ub2e4.",
    "\uadf8\ub9bc/\ubc40\ud30c\ub9ad \uc778\ucc48\ud2b8 \ud65c\uc6a9: \uc7a1\ubab9 \ucc98\uce58 \uc2dc \uc9c0\uc18d\uc801\uc778 \ud53c\ud761\uacfc talents \ubc84\ud504\ub97c \uc720\uc9c0\ud558\uc5ec \uc0dd\uc874\ub825\uc744 \uadf9\ub300\ud654\ud569\ub2c8\ub2e4."
  ],
  "combo_guide": [
    "1\ub2e8\uacc4 (\uc9c4\uc785 \ubc0f \uc720\uc778): Graceful Flame\uacfc \uc6d0\uac70\ub9ac \uacac\uc81c mantras\ub97c \uc0ac\uc6a9\ud558\uc5ec \uc801\ub4e4\uc774 \ud55c\uacf3\uc73c\ub85c \ubb49\uce58\ub3c4\ub85d \uc720\ub3c4\ud569\ub2c8\ub2e4.",
    "2\ub2e8\uacc4 (\uc9c4\ud615 \ubd95\uad34 \ubc0f \uac00\ub4dc \ube0c\ub808\uc774\ud06c): Lava Serpent\uc640 Thunder Strike\ub97c \uc5f0\uacc4\ud558\uc5ec \uc801\uc758 \uc2a4\ud0dc\ubbf8\ub098\ub97c \uae4e\uace0 \uac00\ub4dc\ub97c \uac15\uc81c\ub85c \ud574\uc81c\ud569\ub2c8\ub2e4.",
    "3\ub2e8\uacc4 (\ud3ed\ub51c \ud37c\ubd93\uae30): \uc801\ub4e4\uc774 \uacbd\uc9c1\ub418\uac70\ub098 \uc5d0\uc5b4\ubcf8 \uc0c1\ud0dc\uac00 \ub418\uc5c8\uc744 \ub54c \ud575\uc2ec \uad11\uc5ed mantras\uc640 weapons \uc804\uc6a9 \ud06c\ub9ac\ud2f0\uceec \uacf5\uaca9\uc744 \ud37c\ubd80\uc5b4 \ub300\ubbf8\uc9c0\ub97c \uadf9\ub300\ud654\ud569\ub2c8\ub2e4.",
    "4\ub2e8\uacc4 (\uc774\ud0c8 \ubc0f \uc0dd\uc874): \uad50\uc804 \ud6c4 \ub0a8\uc740 \uc801\uc774 \uc788\ub2e4\uba74 weapons \uc778\ucc48\ud2b8 \ud6a8\uacfc(Vampiric)\ub85c \uccb4\ub825\uc744 \ud68c\ubcf5\ud558\uace0, \uc704\uae09 \uc2dc Wind Up \ubca8\ub85c \uc804\uc7a5\uc744 \uc774\ud0c8\ud569\ub2c8\ub2e4."
  ],
