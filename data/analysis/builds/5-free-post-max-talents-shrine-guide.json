  "mob_strategy": [
    "\ub85c\uc5b4 \uc5d0\ub9ac\uc2dc\uc544\uc758 \uc0e4\ub974\ucf54(Sharko) \uc0ac\ub0e5 \ud018\uc2a4\ud2b8 \uc9c4\ud589 \uc2dc \ub3d9\uad74 \ub0b4\ubd80\uc758 \ub2e4\uc911 \uc2a4\ud3f0 \uc9c0\uc5ed\uc744 \uc870\uc2ec\ud558\uba70 \uc6d0\uac70\ub9ac \ud328\ub9ac \ubc0f \ud0c0\uc774\ubc0d \uac00\ub4dc\ub97c \ud65c\uc6a9\ud569\ub2c8\ub2e4.",
    "\ube44\uc9c8 \ub3c4\uc11c\uad00 \ud018\uc2a4\ud2b8 \uc911 \uce78(Khan)\uacfc\uc758 \uc804\ud22c\uc5d0\uc11c \ub099\uc0ac \uc704\ud5d8\uc744 \ud53c\ud558\uace0 \uad6c\uc11d\uc5d0\uc11c \uc548\uc815\uc801\uc73c\ub85c \uadf8\ub85c\uae30 \ubc0f \ucf64\ubcf4\ub97c \ub204\uc801\ud569\ub2c8\ub2e4.",
    "\uc2e0\uc804(Shrine) \uad6c\uc5ed \uc774\ub3d9 \uc2dc \ub381\uc2a4 \ubc14\uc6b4\ub4dc \ubab9\ub4e4\uc758 \uc5b4\uadf8\ub85c\ub97c \ud53c\ud558\uae30 \uc704\ud574 \uae00\ub77c\uc774\ub354\uc640 \ubcbd \ud0c0\uae30 \ubb34\ube0c\uba3c\ud2b8\ub97c \uc801\uadf9 \ud65c\uc6a9\ud569\ub2c8\ub2e4."
