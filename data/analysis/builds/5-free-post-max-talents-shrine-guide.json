    "build_name": "5 Free Post-Max Talents & Shrine Guide",
    "build_type": "Hybrid",
    "difficulty": "Intermediate",
    "creator_opinion": "\uc774 \uc601\uc0c1\uc740 \ub525\uc704\ud070\uc5d0\uc11c \ub9cc\ub819 \ub3c4\ub2ec \uc774\ud6c4 \ucd94\uac00\uc801\uc778 stats \ud3ec\uc778\ud2b8\ub098 \ub808\ubca8\uc5c5 \uc5c6\uc774\ub3c4 \ucd5c\ub300 5\uac1c\uc758 \ubb34\ub8cc talents(\uce74\ub4dc)\uc640 mantras\ub97c \ud68d\ub4dd\ud560 \uc218 \uc788\ub294 \ud575\uc2ec \ud018\uc2a4\ud2b8 \ub8e8\ud2b8\uc640 \uba54\ucee4\ub2c8\uc998\uc744 \uc0c1\uc138\ud788 \ub2e4\ub8e8\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uccab \ubc88\uc9f8 \uc5d0\ud2b8\ub9ac\uc2a4 \uc0c1\uc810 NPC(Ploom) \ud018\uc2a4\ud2b8, \ub85c\uc5b4 \uc5d0\ub9ac\uc2dc\uc544(Lower Erisia)\uc758 \uc544\uc11c(Arthur) \ubc0f \uc544\ud2b8\ub77c(Atra) \uad00\ub828 \ud018\uc2a4\ud2b8, \uadf8\ub9ac\uace0 \ube44\uc9c8(Isle of VIGILS) \ub3c4\uc11c\uad00\uc758 \uc783\uc5b4\ubc84\ub9b0 \ucc45 \ud018\uc2a4\ud2b8\ub97c \uc5f0\uacc4\ud558\uc5ec \uc9c0\uc2dd(Knowledge)\uacfc \ud018\uc2a4\ud2b8 \ubcf4\uc0c1\uc744 \uadf9\ub300\ud654\ud558\ub294 \ube4c\ub4dc\uc5c5 \uac00\uc774\ub4dc\uc785\ub2c8\ub2e4.\n\n\ud2b9\ud788 \ud68d\ub4dd\ud55c talents\uc640 mantras\ub97c 'Shrine of Division'\uacfc 'Shrine of Chance', 'Shrine of Solitude' \uc2dc\uc2a4\ud15c\uacfc \uc5f0\uacc4\ud558\uc5ec \uc6d0\ud558\ub294 \uce74\ub4dc\ub85c \uad50\ud658\ud558\uace0 \uc7ac\ucd94\ucca8\ud558\ub294 \uba54\ucee4\ub2c8\uc998\uc744 \uc644\ubcbd\ud558\uac8c \ud574\uc124\ud569\ub2c8\ub2e4. \uae38\ub4dc \ubca0\uc774\uc2a4\ub97c \ud65c\uc6a9\ud55c \ub9ac\uc14b \ub2e8\ucd95 \ud301\uacfc \ub525\ubc14\uc6b4\ub4dc(Deepbound) \uc9c4\uc785 \ub8e8\ud2b8\ub97c \ud568\uaed8 \uc0ac\uc6a9\ud558\uc5ec, \uace0\ub819 \uc720\uc800\ub4e4\uc774 \ube4c\ub4dc\ub97c \uc138\ubc00\ud558\uac8c \uc815\uad50\ud654\ud558\uace0 \uc885\uacb0 \uae09 talents\ub97c \uc800\ub834\ud55c \uc9c0\uc2dd \uc18c\ubaa8\ub85c \uc800\uaca9\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub41c \uc2e4\uc804\ud615 \uc720\ud2f8\ub9ac\ud2f0 \uac00\uc774\ub4dc\uc785\ub2c8\ub2e4.",
    "strengths": [
      "\ub9cc\ub819 \uc774\ud6c4\uc5d0\ub3c4 \ucd94\uac00\uc801\uc778 \uc131\uc7a5 \ub3d9\ub825\uacfc 5\uac1c\uc758 \ubb34\ub8cc talents/mantras \uce74\ub4dc\ub97c \uc548\uc815\uc801\uc73c\ub85c \uc218\uae09\ud560 \uc218 \uc788\uc74c",
      "Shrine of Division\uacfc Shrine of Chance\ub97c \uc5f0\uacc4\ud558\uc5ec \uc6d0\uce58 \uc54a\ub294 \uce74\ub4dc\ub97c \uc6d0\ud558\ub294 \uc885\uacb0 talents\ub85c \ubcc0\ud658 \uac00\ub2a5",
      "\uae38\ub4dc \ubca0\uc774\uc2a4 \ub9ac\uc14b\uacfc \uc5f0\uacc4 \uc2dc \ucd08\uace0\uc18d\uc73c\ub85c \ud018\uc2a4\ud2b8\ub97c \ubc18\ubcf5\ud558\uc5ec \uc9c0\uc2dd\uacfc \uce74\ub4dc\ub97c \ud30c\ubc0d\ud560 \uc218 \uc788\uc74c"
    ],
    "weaknesses": [
      "\ud018\uc2a4\ud2b8 \ub3d9\uc120\uc774 \uae38\uace0 \ub85c\uc5b4 \uc5d0\ub9ac\uc2dc\uc544 \ubc0f \ub381\uc2a4(Depths) \uc778\uadfc \uc704\ud5d8 \uc9c0\uc5ed\uc744 \uac70\uccd0\uc57c \ud558\ubbc0\ub85c \uac31\ud06c(Gank) \uc704\ud5d8\uc774 \uc874\uc7ac\ud568",
      "\uace0\uae09 \ud018\uc2a4\ud2b8(Lost Books \ub4f1) \uc9c4\ud589 \uc2dc \uc77c\uc815\ub7c9\uc758 \uc9c0\uc2dd(Knowledge) \uc18c\ubaa8\uac00 \ud544\uc218\uc801\uc774\ubbc0\ub85c \uc0ac\uc804 \ud30c\ubc0d\uc774 \ud544\uc694\ud568"
    ]
