  "combo_guide": {
    "step_1": "\uc5d0\ud2b8\ub9ac\uc2a4 \ubc0f \ub85c\uc5b4 \uc5d0\ub9ac\uc2dc\uc544\uc758 NPC(Ploom, Arthur, Atra)\ub85c\ubd80\ud130 \uac01 \ub2e8\uacc4\ubcc4 \ubb34\ub8cc talents \ud018\uc2a4\ud2b8 \uc218\uc8fc",
    "step_2": "\uc9c0\uc815\ub41c \ubaac\uc2a4\ud130(\uc0e4\ub974\ucf54 \ub4f1) \ud1a0\ubc8c \ubc0f \uc720\uc2e4\ubb3c(\ucc45 \ub4f1) \ud68c\uc218 \uc644\ub8cc \ud6c4 NPC\uc5d0\uac8c \ubcf5\uadc0\ud558\uc5ec \ubcf4\uc0c1 \uce74\ub4dc \ud68d\ub4dd",
    "step_3": "\ud68d\ub4dd\ud55c mantras\uc640 \uc6d0\uce58 \uc54a\ub294 \uce74\ub4dc\ub97c Shrine of Division \ubc0f Shrine of Chance\uc5d0 \ud22c\uc785\ud558\uc5ec \uc6d0\ud558\ub294 \uc885\uacb0 talents\ub85c \uc804\ud658",
