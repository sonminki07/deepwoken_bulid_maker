    "mob_strategy": [
      "\ud328\ud134 \ud30c\ud6fc: \ubab9\uc758 \uc120\ub51c\ub808\uc774\uac00 \uae34 \uad11\uc5ed \uacf5\uaca9 \ubaa8\uc158\uc744 \ud655\uc778\ud55c \uc989\uc2dc \ud68c\ud53c \uae30\ub3d9\uc73c\ub85c \ube60\uc838\ub098\uac00\uba70, \ub2e8\ubc1c \uce74\uc6b4\ud130 \ud0c0\uc774\ubc0d\uc744 \ub178\ub824 Vengeance talents \ubc1c\ub3d9 \uc720\ub3c4.",
      "\ub300\ubbf8\uc9c0 \ub204\uc801: \ub2e8\ubc1c \ub51c\uc758 \ud55c\uacc4\ub97c \uadf9\ubcf5\ud558\uae30 \uc704\ud574 Chain Jail\uacfc Rupture\ub97c \uc5f0\uacc4\ud558\uc5ec \uc9c0\uc18d\uc801\uc778 \ub454\ud654 \ubc0f \ub3c4\ud2b8 \ub300\ubbf8\uc9c0\ub97c \uc548\uc815\uc801\uc73c\ub85c \ub204\uc801.",
      "\uc7a5\ud310 \ud68c\ud53c: \ubcf4\uc2a4\uc804\uc5d0\uc11c \ubc14\ub2e5\uc5d0 \uae54\ub9ac\ub294 \uc7a5\ud310 \ud328\ud134\uc740 \uae30\ub3d9\uc131\uc774 \ub192\uc740 \uc2a4\ud15d\uc744 \ud65c\uc6a9\ud574 \uc989\uc2dc \ud68c\ud53c\ud558\uace0, \ud53c\ud761 \ubc0f \ud3ec\uc2a4\ud2b8\uccd0 \ud68c\ubcf5 \ud0c0\uc774\ubc0d\uc744 \ud655\ubcf4.",
      "\uc815\uc2e0\uc801 \uc555\ubc15: \uc801 \ubaac\uc2a4\ud130\ub098 \uc0c1\ub300 \ud50c\ub808\uc774\uc5b4\uac00 \uac00\ub4dc\ub97c \uc62c\ub9ac\uace0 \ub300\uce58\ud560 \ub54c, \ub04a\uc784\uc5c6\ub294 \uc8fc\uba39 \uc5f0\ud0c0\uc640 \uc2a4\ud0b5\ud37c \ud0a5(Skipper Kick)\uc73c\ub85c \uac00\ub4dc \ube0c\ub808\uc774\ud06c\ub97c \uc720\ubc1c\ud558\uc5ec \uadf8\ub85c\uae30 \uc0c1\ud0dc\ub85c \uc804\ud658."
    ]
