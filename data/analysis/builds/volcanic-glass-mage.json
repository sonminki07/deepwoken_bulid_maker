  "build_summary": {
    "build_name": "Volcanic Glass Mage",
    "build_type": "PvP",
    "difficulty": "Intermediate",
    "creator_opinion": "\uc774 \ube4c\ub4dc\ub294 'Volcanic Glass'\ub77c\ub294 \uba85\uce6d\uc5d0\uc11c \uc54c \uc218 \uc788\ub4ef\uc774, \ud654\uc5fc(Flamecharm)\uacfc \uc5bc\uc74c(Frostdraw) \uc18d\uc131\uc744 \uacb0\ud569\ud558\uc5ec \ud3ed\ubc1c\uc801\uc778 \ud654\ub825\uacfc \uac15\ub825\ud55c \uad70\uc911 \uc81c\uc5b4 \ub2a5\ub825\uc744 \ub3d9\uc2dc\uc5d0 \uac16\ucd98 \ud558\uc774\ube0c\ub9ac\ub4dc \uba54\uc774\uc9c0 \ube4c\ub4dc\uc785\ub2c8\ub2e4. \uc804\ud22c\uc758 \ud575\uc2ec\uc740 '\uc2ac\ub77c\uc774\ub4dc \uce90\uc2a4\ud305(Slide Casting)' \uae30\uc220\uc744 \uadf9\ub300\ud654\ud558\uc5ec \uae30\ub3d9\uc131\uc744 \ud655\ubcf4\ud558\uace0, \uc0c1\ub300\uac00 \ub300\uc751\ud558\uae30 \ud798\ub4e0 \ud0c0\uc774\ubc0d\uc5d0 mantras\ub97c \uc3df\uc544\ubd93\ub294 \uac83\uc785\ub2c8\ub2e4. \n\n\uace0\uc720 \uc2dc\ub108\uc9c0 \uce21\uba74\uc5d0\uc11c, \ud654\uc5fc\uc758 \uc9c0\uc18d \ub300\ubbf8\uc9c0\uc640 \uc5bc\uc74c\uc758 \ub454\ud654/\ube59\uacb0 \ud6a8\uacfc\uac00 \ub9de\ubb3c\ub824 \uc0c1\ub300\uc758 \uc2a4\ud0dc\ubbf8\ub098\ub97c \ube60\ub974\uac8c \uace0\uac08\uc2dc\ud0b5\ub2c8\ub2e4. \ud2b9\ud788 'Meteor Impact'\uc640 'Rising Flame'\uc744 \uc5f0\uacc4\ud55c \ucf64\ubcf4\ub294 \uc0c1\ub300\uc758 \uac00\ub4dc\ub97c \uac15\uc81c\ub85c \ubb34\ub108\ub728\ub9ac\uac70\ub098 \uacf5\uc911\uc5d0 \ub744\uc6cc \ubb34\ubc29\ube44 \uc0c1\ud0dc\ub85c \ub9cc\ub4dc\ub294 \ub370 \ud0c1\uc6d4\ud569\ub2c8\ub2e4. \n\n\uc2e4\uc804 \uc2ec\ub9ac\uc804\uc5d0\uc11c \uc774 \ube4c\ub4dc\ub294 \ub2e8\uc21c\ud788 \uc2a4\ud0ac\uc744 \ub09c\uc0ac\ud558\ub294 \uac83\uc774 \uc544\ub2c8\ub77c, \uc2ac\ub77c\uc774\ub4dc \uce90\uc2a4\ud305\uc744 \ud1b5\ud574 \uc0c1\ub300\uc758 \uacf5\uaca9 \ubc94\uc704\ub97c \ubc97\uc5b4\ub098\uba74\uc11c \uc5ed\uacf5\uc744 \uac00\ud558\ub294 '\ud788\ud2b8 \uc564 \ub7f0' \uc804\uc220\uc5d0 \ucd5c\uc801\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uac00\ub4dc\ube0c\ub808\uc774\ud06c \uc774\ud6c4\uc758 \ud6c4\uc18d\ud0c0 \uc5f0\uacc4\uac00 \ub9e4\uc6b0 \ub9e4\ub044\ub7ec\uc6cc 1\ub3001\uc740 \ubb3c\ub860, \ub2e4\ub300\ub2e4 \uac31\ud0b9 \uc0c1\ud669\uc5d0\uc11c\ub3c4 \uc555\ub3c4\uc801\uc778 \uc874\uc7ac\uac10\uc744 \ubc1c\ud718\ud569\ub2c8\ub2e4.",
    "strengths": [
      "\uc2ac\ub77c\uc774\ub4dc \uce90\uc2a4\ud305\uc744 \ud65c\uc6a9\ud55c \uc555\ub3c4\uc801\uc778 \uae30\ub3d9\uc131\uc73c\ub85c \uc801\uc758 \uacf5\uaca9\uc744 \ud68c\ud53c\ud558\uba70 \uc9c0\uc18d\uc801\uc778 \uc555\ubc15 \uac00\ub2a5",
      "\ud654\uc5fc\uacfc \uc5bc\uc74c \uc18d\uc131\uc758 \uc870\ud569\uc73c\ub85c \uac15\ub825\ud55c \uc0c1\ud0dc \uc774\uc0c1(\ud654\uc0c1, \ub454\ud654)\uacfc \ub192\uc740 \ub204\uc801 \ub300\ubbf8\uc9c0 \ubcf4\uc720",
      "Prophet's Cloak\uc744 \ud65c\uc6a9\ud55c \ub192\uc740 \ud0f1\ud0b9\ub825\uacfc \uc548\uc815\uc801\uc778 \uc720\uc9c0\ub825",
      "\uac00\ub4dc\ube0c\ub808\uc774\ud06c \ubc0f \uc5d0\uc5b4\ubcf8 \uc5f0\uacc4\uac00 \ub9e4\uc6b0 \uc720\uc5f0\ud558\uc5ec \ucf64\ubcf4 \ud30c\ud6fc\uac00 \uc5b4\ub824\uc6c0"
    ],
    "weaknesses": [
      "\uc2ac\ub77c\uc774\ub4dc \uce90\uc2a4\ud305 \uc219\ub828\ub3c4\uac00 \ub0ae\uc744 \uacbd\uc6b0 \uae30\ub3d9\uc131\uc774 \uae09\uaca9\ud788 \uc800\ud558\ub428",
      "\uc2a4\ud0dc\ubbf8\ub098 \uad00\ub9ac\uc5d0 \uc2e4\ud328\ud558\uba74 \uba54\uc774\uc9c0 \ud2b9\uc131\uc0c1 \uadfc\uc811\uc804\uc5d0\uc11c \ucde8\uc57d\ud574\uc9c8 \uc218 \uc788\uc74c",
      "\ud2b9\uc815 \uc18d\uc131 \uc800\ud56d\uc774 \ub192\uc740 \uc0c1\ub300\uc5d0\uac8c\ub294 \ub300\ubbf8\uc9c0 \ud6a8\uc728\uc774 \ub2e4\uc18c \uac10\uc18c\ud560 \uc218 \uc788\uc74c"
    ]
  },
