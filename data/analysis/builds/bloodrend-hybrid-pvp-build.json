    "mob_strategy": [
      "\uadfc\uc811 \ubaac\uc2a4\ud130 \uc0c1\ub300 \uc2dc Shadow Travel\uc744 \ud65c\uc6a9\ud574 \uce21\uba74\uc744 \uc7a1\uace0 \uc120\uacf5\uad8c\uc744 \ud655\ubcf4\ud558\uc138\uc694.",
