  "combo_guide": {
    "step_1_engage": "\ucca0\uc800\ud55c \uae30\ub3d9\uc131\uc744 \ubc14\ud0d5\uc73c\ub85c \uc2ac\ub77c\uc774\ub4dc \uc810\ud504\ub97c \ud65c\uc6a9\ud574 \uc801\uc758 \uacf5\uaca9 \ubc94\uc704\ub97c \ud68c\ud53c\ud558\uba70 \uc778\ud30c\uc774\ud305 \uac70\ub9ac\ub97c \uc881\ud799\ub2c8\ub2e4.",
    "step_2_break": "\uc2a4\ud2f8\uc2a4\ucf00\uc77c \ub354\uc2a4\ud130\uc758 \ud06c\ub9ac\ud2f0\uceec \ud788\ud2b8 \ubc0f 'Metal Kick'\uc744 \uc801\uc911\uc2dc\ucf1c \uc801\uc758 \uac00\ub4dc\ub97c \ubd95\uad34\uc2dc\ud0a4\uace0 \ub109\ub2e4\uc6b4 \uc0c1\ud0dc\ub97c \uc720\ub3c4\ud569\ub2c8\ub2e4.",
